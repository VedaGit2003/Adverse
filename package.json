{
  "name": "adverse-hoardings-platform",
  "version": "1.0.0",
  "description": "Multi-tenant OOH Hoarding Rental & Management Platform for West Bengal",
  "private": true,
  "workspaces": [
    "server",
    "client-web"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "seed": "node server/src/seed.js",
    "dev:server": "npm --prefix server run dev",
